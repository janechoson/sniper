generator client {
  provider = "prisma-client"
  output = "../generated/client"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
// Nhật ký chỉ ghi thêm là nguồn dữ liệu chính của bộ mô phỏng. Các mô hình khác
// chứa dữ liệu chuẩn hóa có chỉ mục; thông tin chưa rõ không được mặc định là an toàn.
model JournalEntry {
  id String @id
  sequence BigInt @unique @default(autoincrement())
  kind String
  chainId String?
  tokenAddress String?
  payload Json
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
  @@index([chainId, tokenAddress, createdAt])
}
model EngineLease {
  id String @id
  owner String
  expiresAt DateTime
}
model RugCheckSnapshot {
  id String @id
  namespace String
  chainId String
  tokenAddress String
  poolAddress String?
  snapshotHash String
  source String
  decision String?
  payload Json
  observedAt DateTime
  @@index([namespace, chainId, tokenAddress, observedAt])
  @@index([namespace, snapshotHash])
  @@map("rug_check_snapshots")
}
model SecurityEvidence {
  id String @id
  namespace String
  snapshotId String
  field String
  provider String
  origin String
  state String
  payload Json
  observedAt DateTime
  @@index([namespace, snapshotId, field])
  @@index([namespace, provider, state, observedAt])
  @@map("security_evidence")
}
