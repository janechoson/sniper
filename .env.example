# Own credentials only. Never copy BOT B .env or wallet material.
KRONOS_PORT=3001
KRONOS_GMGN_API_KEY=
KRONOS_RPC_URL=
KRONOS_DATABASE_PATH=
KRONOS_RUNTIME=runtime
KRONOS_LOG_DIR=logs
KRONOS_WALLET_PUBLIC_KEY=
KRONOS_PRIVATE_KEY=
KRONOS_KEYPAIR_PATH=

# Optional LIVE capability. PAPER default; collection always starts paused.
# Optional, same as BOT B: empty omits the x-api-key header.
KRONOS_JUPITER_API_KEY=

TRADING_MODE=live
KRONOS_LIVE_ACK=I_ACCEPT_REAL_TRADING
KRONOS_EXECUTION_DRY_RUN=true

