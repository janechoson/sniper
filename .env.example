TRADING_MODE=demo
LIVE_TRADING_ACK=false
NEW_ENTRIES_ENABLED=true
# Official CLI global config (~/.config/gmgn/.env) takes precedence for GMGN credentials.
GMGN_API_KEY=
# GMGN API authentication key, NOT a Solana wallet key. Backend only.
GMGN_PRIVATE_KEY=
# Optional PEM reference; defaults to ~/.config/gmgn/keypair.pem generated by gmgn-cli config.
GMGN_PRIVATE_KEY_PATH=
# Public address of the Solana wallet bound to your GMGN API key.
WALLET_PUBLIC_KEY=
SOLANA_RPC_URL=
DATABASE_PATH=
PORT=3000
SCANNER_ENABLED=true
SCAN_INTERVAL_MS=15000
# DEMO initializes persistent virtual capital of 100 SOL once.
OBSERVATION_CYCLES=3

SOLANA_PRIVATE_KEY=

# One-shot execution test only; independent of strategy mode/ACK. Never auto-enabled.
LIVE_SMOKE_TEST_SOL=0.005
LIVE_SMOKE_TEST_ACK=false
TEMP_BYPASS_RECOVERY_GUARD=false
