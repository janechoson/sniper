TRADING_MODE=demo
LIVE_TRADING_ACK=false
NEW_ENTRIES_ENABLED=true
# Official CLI global config (~/.config/gmgn/.env) takes precedence for GMGN credentials.
GMGN_API_KEY=
# GMGN API authentication key, NOT a Solana wallet key. Backend only.
GMGN_PRIVATE_KEY=
# Optional PEM reference; defaults to ~/.config/gmgn/keypair.pem generated by gmgn-cli config.
GMGN_PRIVATE_KEY_PATH=
# Public address of the Solana wallet bound to your GMGN API key.
WALLET_PUBLIC_KEY=
JUPITER_API_KEY=
SOLANA_RPC_URL=
DATABASE_PATH=
PORT=3000
SCANNER_ENABLED=true
SCAN_INTERVAL_MS=15000
# DEMO initializes persistent virtual capital of 100 SOL once.
OBSERVATION_CYCLES=3

# Optional Chart Learning reasoning. No wallet keys enter this runtime.
# Set an API-accessible Codex model explicitly; no implicit model substitution.
OPENAI_API_KEY=
CODEX_MODEL=
CODEX_DEEP_MODEL=gpt-6.1-sol
# Optional cost estimate. Supply both rates in USD per 1M input/output tokens.
CODEX_INPUT_USD_PER_1M_TOKENS=
CODEX_OUTPUT_USD_PER_1M_TOKENS=
AI_GUARD_ENABLED=true
AI_GUARD_TIMEOUT_MS=30000
AI_GUARD_PASS_TTL_MS=45000
AI_GUARD_MAX_CONCURRENCY=1
AI_GUARD_MAX_ATTEMPTS=1
AI_GUARD_FAIL_POLICY=BLOCK
AUTO_CHART_LEARNING_ENABLED=true
AUTO_CHART_LEARNING_DELAY_MS=30000
AUTO_CHART_LEARNING_MAX_CONCURRENCY=1
AUTO_CHART_LEARNING_MIN_CANDLES=30
AUTO_CHART_LEARNING_ALLOW_INCOMPLETE=true
CODEX_MAX_CONCURRENCY=1
CODEX_MIN_REQUEST_INTERVAL_MS=30000
KNOWLEDGE_VALIDATION_MIN_CASES=30
KNOWLEDGE_VALIDATION_MIN_POSITIVE=10
KNOWLEDGE_VALIDATION_MIN_NEGATIVE=10
KNOWLEDGE_VALIDATION_MIN_PRECISION=0.7
KNOWLEDGE_VALIDATION_MIN_RECALL=0.7
KNOWLEDGE_VALIDATION_MAX_FALSE_POSITIVE_RATE=0.2
KNOWLEDGE_VALIDATION_MAX_ABSTENTION_RATE=0.2
KNOWLEDGE_VALIDATION_MIN_PRECISION_LCB=0.4
KNOWLEDGE_VALIDATION_MIN_RECALL_LCB=0.4
KNOWLEDGE_VALIDATION_DANGEROUS_PNL_PCT=-20
KNOWLEDGE_DRIFT_MIN_CASES=10
KNOWLEDGE_DRIFT_MAX_DANGEROUS_RATE=0.3
# Optional directory for demo.sqlite/live.sqlite/learning.sqlite. DATABASE_PATH
# remains the legacy import source for backward compatibility.
DATABASE_DIRECTORY=data

SOLANA_PRIVATE_KEY=

# One-shot execution test only; independent of strategy mode/ACK. Never auto-enabled.
LIVE_SMOKE_TEST_SOL=0.005
LIVE_SMOKE_TEST_ACK=false
TEMP_BYPASS_RECOVERY_GUARD=false
