# Quan sát dữ liệu thật; không ký hoặc broadcast, chưa cần khóa ví.
DATA_MODE=real
TRADING_MODE=paper
LIVE_DRY_RUN=false
LIVE_TRADING_ACK=false
AI_PROVIDER=jev
# REAL: Node.js >=22; DATA_MODE=real, AI_PROVIDER=jev; giữ TRADING_MODE=paper.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_MS=3000
# JUPITER_API_KEY=
# SOLANA_RPC_HTTP=
# SOLANA_RPC_WS=
# SOLANA_EXPECTED_GENESIS_HASH=
# BNB_RPC_HTTP=
# BNB_RPC_WS=
# ROBINHOOD_RPC_HTTP=
# ROBINHOOD_RPC_WS=
REAL_CONFIG_PATH=config/observation.json
# Chuẩn bị LIVE không phát giao dịch: TRADING_MODE=live_dry_run,
# OBSERVATION_ONLY=false, OBSERVATION_AUTO_START=false,
# REAL_CONFIG_PATH=config/live.json; giữ LIVE_TRADING_ACK=false.
# pnpm verify:live chỉ đọc RPC; xem docs/live-activation-20261028.md.
# Ví cố định: chỉ backend đọc khóa, PAPER không cần khóa.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=
EVM_WALLET_ADDRESS=
SOLANA_WALLET_ADDRESS=
RPC_TIMEOUT_MS=7000
RPC_REQUESTS_PER_SECOND=5
RPC_MAX_CONCURRENCY=4
RUN_LIVE_TESTS=false
STORAGE_DRIVER=sqlite
SQLITE_PATH=data/trading.db
PORT=3000
DATA_DIRECTORY=data
ENABLED_CHAINS=solana,bnb,robinhood
LOG_LEVEL=info

# Kích thước lệnh/giới hạn ngày lưu trong settings; deployment/feed/Rug Check trong REAL_CONFIG_PATH.
# Không thêm BUY_AMOUNT, SCAN_INTERVAL hoặc key GoPlus/Honeypot/RugCheck: runtime không đọc các biến này.

OBSERVATION_ONLY=true
OBSERVATION_AUTO_START=true
OBSERVATION_AI_INTERVAL_MS=20000
IMPORT_LEGACY_JOURNAL=false
