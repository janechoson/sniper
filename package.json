{
  "name": "multi-chain-ai-sniper",
  "description": "Ứng dụng nghiên cứu giao dịch mô phỏng đa chuỗi với giao diện tiếng Việt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "effect": "^3.20.0",
      "deepmerge-ts": "^8.0.0",
      "@coral-xyz/anchor>toml": "5.0.1"
    },
    "patchedDependencies": {
      "bigint-buffer@1.1.5": "patches/bigint-buffer@1.1.5.patch"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --import tsx scripts/local.mjs dev",
    "start": "node --import tsx scripts/local.mjs start",
    "build": "pnpm typecheck && node scripts/next.mjs build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "db:generate": "tsx --env-file-if-exists=.env scripts/database.ts generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/database.ts migrate",
    "db:validate": "tsx --env-file-if-exists=.env scripts/database.ts validate",
    "db:backup": "tsx --env-file-if-exists=.env scripts/database.ts backup",
    "db:restore": "tsx --env-file-if-exists=.env scripts/database.ts restore",
    "db:import": "tsx --env-file-if-exists=.env scripts/database.ts import",
    "postinstall": "pnpm db:generate",
    "verify:solana": "tsx --env-file-if-exists=.env scripts/verify.ts solana",
    "verify:pump": "node --import tsx scripts/verify-pump.mjs",
    "verify:bnb": "tsx --env-file-if-exists=.env scripts/verify.ts bnb",
    "verify:robinhood": "tsx --env-file-if-exists=.env scripts/verify.ts robinhood",
    "verify:wallets": "tsx --env-file-if-exists=.env scripts/verify.ts wallets",
    "verify:live": "node scripts/verify-live-dry-run.mjs --infrastructure",
    "verify:live-dry-run:solana": "node scripts/verify-live-dry-run.mjs solana",
    "verify:live-dry-run:bnb": "node scripts/verify-live-dry-run.mjs bnb",
    "verify:live-dry-run:robinhood": "node scripts/verify-live-dry-run.mjs robinhood",
    "verify:quotes": "tsx --env-file-if-exists=.env scripts/verify.ts quotes",
    "verify:idls": "node scripts/verify-idls.mjs",
    "verify:rug": "tsx --env-file-if-exists=.env scripts/verify-rug.ts",
    "audit:production": "node scripts/audit-production.mjs",
    "reference:config": "tsx scripts/prepare-reference.ts",
    "verify:discovery:bnb": "tsx --env-file-if-exists=.env scripts/verify-discovery.ts bnb",
    "verify:discovery:robinhood": "tsx --env-file-if-exists=.env scripts/verify-discovery.ts robinhood",
    "verify:discovery:abis": "node --import tsx scripts/verify-discovery-abis.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@prisma/client": "6.19.0",
    "@sniper/ai": "workspace:*",
    "@sniper/chains": "workspace:*",
    "@sniper/config": "workspace:*",
    "@sniper/core": "workspace:*",
    "@sniper/dex": "workspace:*",
    "@sniper/engine": "workspace:*",
    "@sniper/execution": "workspace:*",
    "@sniper/features": "workspace:*",
    "@sniper/positions": "workspace:*",
    "@sniper/risk": "workspace:*",
    "@sniper/routing": "workspace:*",
    "@sniper/shared": "workspace:*",
    "@sniper/storage": "workspace:*",
    "@sniper/strategies": "workspace:*",
    "@sniper/wallet": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@typesafe-ai/sdk": "^0.7.0",
    "next": "^16.0.0",
    "pino": "^9.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
