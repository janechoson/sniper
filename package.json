{
  "name": "k1ll-kronos-paper-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests public/*.js",
    "test": "tsx --import ./scripts/test-env.mjs --test tests/*.test.ts",
    "test:ui": "node scripts/ui-test.mjs",
    "model:prepare": "node scripts/prepare-model.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.98.4",
    "dotenv": "17.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "node": "22.22.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node",
      "node-bin-setup",
      "esbuild"
    ],
    "overrides": {
      "@solana/web3.js>jayson": "5.0.0"
    },
    "patchedDependencies": {
      "bigint-buffer@1.1.5": "patches/bigint-buffer@1.1.5.patch"
    }
  }
}
